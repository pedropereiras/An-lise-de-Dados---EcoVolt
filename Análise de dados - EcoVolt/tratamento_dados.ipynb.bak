   "source": [
    "# (a) BR (total nacional) misturado com as UFs\n",
    "nac = d2_raw[d2_raw.uf == 'BR']; est = d2_raw[d2_raw.uf != 'BR']\n",
    "print('linhas BR:', len(nac), '| soma BR:', nac.emplacamentos.sum(), '| soma UFs:', est.emplacamentos.sum(), '| soma de tudo (dupla contagem):', d2_raw.emplacamentos.sum())\n",
    "mt = pd.concat([nac.groupby('mes').emplacamentos.sum(), est.groupby('mes').emplacamentos.sum()], axis=1, keys=['BR', 'soma_UFs'])\n",
    "mt['dif'] = mt.BR - mt.soma_UFs\n",
    "print('meses em que BR != soma das UFs:'); display(mt[mt.dif != 0])\n",
    "\n",
    "# (b) chaves duplicadas\n",
    "k = ['mes', 'uf', 'marca', 'modelo']\n",
    "print('\\nlinhas com chave (mes,uf,marca,modelo) repetida:', d2_raw.duplicated(k, keep=False).sum(), '(inclui tecnologias diferentes)')\n",
    "k5 = k + ['tecnologia']\n",
    "print('chave + tecnologia repetida (linhas extras):', d2_raw.duplicated(k5).sum(), '| com a mesma quantidade (repetição exata):', d2_raw.duplicated(k5 + ['emplacamentos']).sum())\n",
    "display(d2_raw[d2_raw.duplicated(k5, keep=False)].groupby(['marca', 'modelo']).size().sort_values(ascending=False).head(8).to_frame('linhas'))"
   ]
  },
