   "source": [
    "# (a) SOH acima de 100\n",
    "print('SOH > 100:', (d1_raw.SOH > 100).sum(), 'linhas')\n",
    "display(d1_raw[d1_raw.SOH > 100])\n",
    "\n",
    "# (b) ciclos ausentes\n",
    "ausentes = []\n",
    "for b, g in d1_raw.groupby('battery_id'):\n",
    "    c = g.cycle_number.values\n",
    "    for x in sorted(set(range(c.min(), c.max() + 1)) - set(c)):\n",
    "        ausentes.append({'battery_id': b, 'cycle_number_ausente': x})\n",
    "ausentes = pd.DataFrame(ausentes)\n",
    "print('\\nciclos ausentes:', len(ausentes))\n",
    "display(ausentes.groupby('battery_id').cycle_number_ausente.apply(list).to_frame())"
   ]
  },
