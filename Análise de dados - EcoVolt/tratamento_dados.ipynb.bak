     "text": [
      "\n",
      "modelos com > 1 tecnologia: 10\n",
      "nomes de modelo em > 1 marca: ['E5', 'Ecocargo', 'Ecotech 2', 'Q6 e-tron', 'RD6', 'Seres 3', 'X']\n"
     ]
    }
   ],
   "source": [
    "# (c) marca desconhecida\n",
    "display(d2_raw[d2_raw.marca == 'Desconhecido'].groupby(['marca', 'modelo']).size().to_frame('linhas'))\n",
    "print('Q6 e-tron nas demais linhas:', d2_raw[(d2_raw.modelo == 'Q6 e-tron') & (d2_raw.marca != 'Desconhecido')].marca.unique())\n",
    "\n",
    "# (d) grafias inconsistentes\n",
    "for pat in ['^Tan$|^TAN$|^Box$|^BOX$', 'Fpace|F-Pace', 'G63|G 63', 'Yuan']:\n",
    "    s = d2_raw[d2_raw.modelo.str.contains(pat, regex=True)]\n",
    "    display(s.groupby(['marca', 'modelo', 'tecnologia']).agg(linhas=('mes', 'size'), de=('mes', 'min'), ate=('mes', 'max')))\n",
    "print('marcas com caixa/grafia a revisar:', [m for m in d2_raw.marca.unique() if m in ('KIA', 'Dfsk', 'MON', 'Hitech', 'Hitech E')])\n",
    "\n",
    "# (e) modelos com mais de uma tecnologia e modelos de mesmo nome em marcas diferentes\n",
    "mt2 = d2_raw.groupby(['marca', 'modelo']).tecnologia.nunique(); print('\\nmodelos com > 1 tecnologia:', (mt2 > 1).sum())\n",
    "mb = d2_raw.groupby('modelo').marca.nunique(); print('nomes de modelo em > 1 marca:', list(mb[mb > 1].index))"
   ]
  },
  {
   "cell_type": "markdown",
   "id": "8d192589",
   "metadata": {},
   "source": [
    "## 2.3 Tratamento"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 11,
   "id": "7ce034ce",
   "metadata": {
    "execution": {
     "iopub.execute_input": "2026-10-13T20:33:00.061393Z",
     "iopub.status.busy": "2026-10-13T20:33:00.061111Z",
     "iopub.status.idle": "2026-10-13T20:33:01.492335Z",
     "shell.execute_reply": "2026-10-13T20:33:01.490773Z"
    }
   },
   "outputs": [],
   "source": [
    "log2 = novo_log()\n",
    "d2 = d2_raw.copy()\n",
    "total0 = int(d2.emplacamentos.sum())\n",
    "tot_nac0 = int(d2[d2.uf == 'BR'].emplacamentos.sum()); tot_est0 = int(d2[d2.uf != 'BR'].emplacamentos.sum())\n",
    "\n",
    "# 1) mes -> data; nível nacional/estadual\n",
    "d2['ano_mes'] = d2['mes']\n",
    "d2['mes'] = pd.to_datetime(d2['mes'] + '-01')\n",
    "d2['nivel'] = np.where(d2.uf == 'BR', 'nacional', 'estadual')\n",
    "registrar(log2, 'mes convertido para data (1º dia do mês); ano_mes mantido como texto', len(d2))\n",
    "registrar(log2, 'coluna nivel criada (nacional = uf BR; estadual = demais)', (d2.nivel == 'nacional').sum(), 'saídas separadas por nível')\n",
    "\n",
    "# 2) auditoria das chaves duplicadas ORIGINAIS (antes de padronizar)\n",
    "kor = ['ano_mes', 'uf', 'marca', 'modelo', 'tecnologia']\n",
    "dup = d2[d2.duplicated(kor, keep=False)].copy()\n",
    "gq = dup.groupby(kor).emplacamentos\n",
    "dup['n_linhas_grupo'] = gq.transform('size'); dup['mesma_quantidade_em_todas'] = gq.transform('nunique') == 1\n",
    "dup.sort_values(kor).drop(columns=['mes', 'posicao']).to_csv(OUT / 'auditoria' / 'd2_chaves_duplicadas_originais.csv', index=False)\n",
    "dup[dup.mesma_quantidade_em_todas].sort_values(kor).drop(columns=['mes', 'posicao']).to_csv(OUT / 'auditoria' / 'd2_repeticoes_exatas.csv', index=False)\n",
    "registrar(log2, 'chaves duplicadas (mes,uf,marca,modelo,tecnologia) detectadas', d2.duplicated(kor).sum(),\n",
    "          f'{d2.duplicated(kor + [\"emplacamentos\"]).sum()} repetições exatas; tratadas como versões agrupadas sob o mesmo nome e SOMADAS')\n",
    "registrar(log2, 'linhas com mesma chave sem tecnologia (mes,uf,marca,modelo)', d2.duplicated(['mes', 'uf', 'marca', 'modelo'], keep=False).sum(),\n",
    "          'tecnologias diferentes NÃO são duplicata: mantidas separadas')\n",
    "\n",
    "# 3) padronização de marca e modelo (valores originais preservados)\n",
    "d2['marca_original'] = d2['marca']; d2['modelo_original'] = d2['modelo']\n",
    "assert list(d2[(d2.modelo == 'Q6 e-tron') & (d2.marca != 'Desconhecido')].marca.unique()) == ['Audi']\n",
    "m = (d2.marca == 'Desconhecido') & (d2.modelo == 'Q6 e-tron'); d2.loc[m, 'marca'] = 'Audi'\n",
    "registrar(log2, \"marca 'Desconhecido' -> 'Audi' (modelo Q6 e-tron)\", m.sum(), 'marca_original preservada')\n",
    "mm = {'KIA': 'Kia', 'Dfsk': 'DFSK'}; m = d2.marca.isin(mm); d2['marca'] = d2.marca.replace(mm)\n",
    "registrar(log2, 'caixa de marca padronizada (KIA->Kia, Dfsk->DFSK); Mini e MON mantidas', m.sum(), 'decisão estilística')\n",
    "mapa_modelo = {('BYD', 'TAN'): 'Tan', ('Dongfeng', 'BOX'): 'Box', ('Jaguar', 'Fpace'): 'F-Pace', ('Mercedes-Benz', 'G63AMG'): 'AMG G 63'}\n",
    "d2['modelo_padronizado'] = [mapa_modelo.get((a, b), b) for a, b in zip(d2.marca, d2.modelo)]\n",
    "registrar(log2, 'grafias unificadas em modelo_padronizado: TAN->Tan, BOX->Box, Fpace->F-Pace, G63AMG->AMG G 63', (d2.modelo_padronizado != d2.modelo).sum(),\n",
    "          'tecnologia NÃO alterada (Fpace=PHEV x F-Pace híbrido leve=MHEV; G63AMG=HEV x AMG G 63=MHEV): a confirmar na fonte')\n",
    "\n",
    "# 4) consolidação por soma\n",
    "chave = ['mes', 'ano_mes', 'nivel', 'uf', 'marca', 'modelo_padronizado', 'tecnologia']\n",
    "agg = d2.groupby(chave, as_index=False).agg(\n",
    "    emplacamentos=('emplacamentos', 'sum'), n_linhas_origem=('emplacamentos', 'size'),\n",
    "    marca_original=('marca_original', lambda s: ' | '.join(sorted(set(s)))),\n",
    "    modelo_original=('modelo_original', lambda s: ' | '.join(sorted(set(s)))))\n",
    "agg['consolidado'] = agg.n_linhas_origem > 1\n",
    "registrar(log2, 'linhas consolidadas por soma de emplacamentos', len(d2) - len(agg), f'{len(d2)} -> {len(agg)} linhas; total preservado')\n",
    "assert agg.emplacamentos.sum() == total0\n",
    "\n",
    "# 5) modelo_limpo / versao / chave_modelo\n",
    "vmap = {'Yuan Plus': ('Yuan', 'Plus'), 'Yuan Pro': ('Yuan', 'Pro')}\n",
    "def separar(nome):\n",
    "    if nome in vmap: return vmap[nome]\n",
    "    r = re.match(r'^(.*?)\\s*\\((.*)\\)\\s*$', nome)\n",
    "    return (r.group(1).strip(), r.group(2).strip()) if r else (nome, '')\n",
    "sv = agg.modelo_padronizado.map(separar)\n",
    "agg['modelo_limpo'] = sv.str[0]; agg['versao'] = sv.str[1]\n",
    "agg['chave_modelo'] = agg.marca + '|' + agg.modelo_limpo + '|' + agg.tecnologia\n",
    "registrar(log2, 'modelo_limpo/versao: conteúdo entre parênteses movido para versao; Yuan Plus/Yuan Pro -> modelo_limpo Yuan', (agg.versao != '').sum())\n",
    "yp = agg[agg.modelo_original.str.contains('Yuan')]\n",
    "mistura = yp.groupby(['mes', 'uf']).modelo_original.apply(lambda s: ('Yuan (Pro + Plus)' in set(s)) and len(set(s)) > 1).sum()\n",
    "registrar(log2, 'verificação: Yuan Plus/Pro misturados com Yuan (Pro + Plus) no mesmo mes e uf', mistura, '0 = sem dupla contagem')\n",
    "\n",
    "# 6) posicao recalculada\n",
    "agg = agg.sort_values(['mes', 'nivel', 'uf', 'emplacamentos', 'marca', 'modelo_padronizado'], ascending=[True, True, True, False, True, True])\n",
    "agg['posicao'] = agg.groupby(['mes', 'uf']).cumcount() + 1\n",
    "registrar(log2, 'coluna posicao original removida e recalculada por mes e uf', len(agg), 'desempate por marca e modelo (a ordem dos empates na fonte era arbitrária)')\n",
    "\n",
    "cols2 = ['mes', 'ano_mes', 'nivel', 'uf', 'posicao', 'marca', 'marca_original', 'modelo_padronizado', 'modelo_limpo', 'versao', 'modelo_original',\n",
    "         'chave_modelo', 'tecnologia', 'emplacamentos', 'n_linhas_origem', 'consolidado']\n",
    "agg = agg[cols2].sort_values(['mes', 'nivel', 'uf', 'posicao']).reset_index(drop=True)\n",
    "d2_nac = agg[agg.nivel == 'nacional'].copy(); d2_est = agg[agg.nivel == 'estadual'].copy()"
   ]
  },
