   "source": [
    "d3_raw = pd.read_csv(RAW / '5_596Ah_charge.csv')\n",
    "print('shape:', d3_raw.shape, '| nulos:', d3_raw.isna().sum().sum()); assert d3_raw.shape == (4180, 4)\n",
    "display(d3_raw.head(3)); display(d3_raw.tail(3))\n",
    "t = pd.to_datetime(d3_raw.Date_Time, format='%Y-%m-%d %H:%M:%S')\n",
    "print('Date_Time é', d3_raw.Date_Time.dtype, '| início:', t.min(), '| fim:', t.max())\n",
    "dt = t.diff().dt.total_seconds()\n",
    "print('intervalos entre amostras (s):', dt.value_counts().to_dict(), '| timestamps duplicados:', t.duplicated().sum())\n",
    "display(d3_raw[t.duplicated(keep=False)])"
   ]
