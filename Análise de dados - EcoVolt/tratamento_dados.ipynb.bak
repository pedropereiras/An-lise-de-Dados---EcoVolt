   "source": [
    "d2_raw = pd.read_csv(RAW / 'recarregados-emplacamentos-eletricos-hibridos_1.csv', encoding='utf-8-sig')\n",
    "print('shape:', d2_raw.shape, '| nulos:', d2_raw.isna().sum().sum())\n",
    "display(d2_raw.head())\n",
    "print('meses:', d2_raw.mes.min(), 'a', d2_raw.mes.max(), '| UFs:', d2_raw.uf.nunique(), '| marcas:', d2_raw.marca.nunique(), '| modelos:', d2_raw.modelo.nunique())\n",
    "print('total de emplacamentos (todas as linhas, inclui BR):', d2_raw.emplacamentos.sum())"
   ]
  },
