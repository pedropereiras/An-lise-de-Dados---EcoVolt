    "# (c) fim de vida extremo e (d) resistência repetida\n",
    "print('SOH < 80 :', (d1_raw.SOH < 80).sum(), 'linhas | SOH < 30:', (d1_raw.SOH < 30).sum(), '| SOH mínimo:', round(d1_raw.SOH.min(), 2))\n",
