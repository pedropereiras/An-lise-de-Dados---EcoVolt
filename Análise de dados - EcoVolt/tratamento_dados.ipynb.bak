   "source": [
    "assert not d3.datetime.duplicated().any() and d3.datetime.is_monotonic_increasing\n",
    "assert len(d3) == len(d3_raw) - 1\n",
    "assert abs(d3.soc_recalculado.iloc[-1] - 1) < 0.01\n",
    "assert d3.fase.iloc[0] == 'CC' and d3.fase.iloc[-1] == 'CV'\n",
