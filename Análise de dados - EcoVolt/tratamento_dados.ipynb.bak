   ],
   "source": [
    "log3 = novo_log()\n",
    "d3 = d3_raw.copy()\n",
    "d3.columns = ['datetime', 'voltage_v', 'current_a', 'soc_original']\n",
    "d3['datetime'] = pd.to_datetime(d3.datetime, format='%Y-%m-%d %H:%M:%S')\n",
    "registrar(log3, 'datetime convertido de texto para datetime', len(d3))\n",
    "registrar(log3, 'diagnóstico do SOC original', 0, f'capacidade implícita {1 / razao.median():.3f} Ah; Ah integrados {(I.iloc[1:] * dt.iloc[1:] / 3600).sum():.3f}; nominal 5,596 Ah; SOC inicial {soc.iloc[0]:.4f}')\n",
    "\n",
    "# linha final duplicada (fim de teste, I = 0) -> auditoria\n",
    "dup = d3.datetime.duplicated(keep='last')\n",
    "rej = d3[dup].copy(); rej['motivo'] = 'timestamp duplicado / registro de fim de teste (corrente 0)'\n",
    "rej.to_csv(OUT / 'auditoria' / 'd3_rejeitados.csv', index=False)\n",
    "d3 = d3[~dup].copy()\n",
    "registrar(log3, 'linha final com timestamp duplicado (19:17:14, I=0 A) movida para auditoria/d3_rejeitados.csv', len(rej), 'a linha anterior permanece como último ponto da curva')\n",
    "\n",
    "d3['elapsed_s'] = (d3.datetime - d3.datetime.iloc[0]).dt.total_seconds().astype(int)\n",
    "dts = d3.elapsed_s.diff().fillna(0)\n",
    "d3['soc_recalculado'] = (d3.current_a * dts / 3600).cumsum() / 5.596          # coulomb counting, 5,596 Ah, partindo de 0\n",
    "registrar(log3, 'soc_recalculado por contagem de coulomb (5,596 Ah, início em 0, dt = 1 s)', len(d3), f'final = {d3.soc_recalculado.iloc[-1]:.4f}; soc_original preservado; ORIGEM DO SOC ORIGINAL A CONFIRMAR')\n",
    "\n",
    "d3['transiente_inicial'] = False; d3.loc[d3.index[0], 'transiente_inicial'] = True\n",
    "registrar(log3, 'transiente_inicial sinalizado na 1ª linha (I=5,997 A, V=2,934 V)', 1)\n",
    "\n",
    "inicio_cv = d3.index[d3.current_a < 5.9].min()\n",
    "d3['fase'] = np.where(d3.index < inicio_cv, 'CC', 'CV')\n",
    "registrar(log3, 'fase CC/CV: CV a partir da 1ª amostra com corrente < 5,9 A', (d3.fase == 'CV').sum(), f'CV começa em elapsed_s = {d3.loc[inicio_cv, \"elapsed_s\"]}')\n",
    "registrar(log3, 'documentação: corrente positiva = carga (no D1 a descarga é negativa); SOC em fração 0-1 (SOH do D1 em %); sem battery_id; sem join com D1/D2', 0)\n",
    "d3 = d3[['datetime', 'elapsed_s', 'voltage_v', 'current_a', 'soc_original', 'soc_recalculado', 'fase', 'transiente_inicial']]\n",
    "display(salvar_log(log3, 'd3'))"
   ]
  },
