      "SOH: |desvio| > 5 pontos      : 40\n",
      "Tensão: |desvio| > 0,1 V       : 10\n",
      "Resistência: |desvio| > 0,02 Ω : 9\n"
     ]
    }
   ],
   "source": [
    "# (f) picos: SOH, tensão e resistência vs mediana móvel (janela 11 ciclos)\n",
    "def rmed(s, w=11):\n",
    "    return s.rolling(w, center=True, min_periods=3).median()\n",
    "\n",
    "tmp = d1_raw.sort_values(['battery_id', 'cycle_number']).copy()\n",
    "gb = tmp.groupby('battery_id')\n",
    "tmp['res_soh'] = tmp.SOH - gb.SOH.transform(rmed)\n",
    "tmp['res_v'] = tmp.average_voltage_V - gb.average_voltage_V.transform(rmed)\n",
    "tmp['res_r'] = tmp.internal_resistance_ohm - gb.internal_resistance_ohm.transform(rmed)\n",
    "print('SOH: |desvio| > 5 pontos      :', (tmp.res_soh.abs() > 5).sum())\n",
    "print('Tensão: |desvio| > 0,1 V       :', (tmp.res_v.abs() > 0.1).sum())\n",
    "print('Resistência: |desvio| > 0,02 Ω :', (tmp.res_r.abs() > 0.02).sum())"
   ]
  },
