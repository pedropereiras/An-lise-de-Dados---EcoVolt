   "source": [
    "# 7) reconciliação nacional x estadual e relatórios de revisão\n",
    "a = d2_nac.groupby(['ano_mes', 'marca', 'modelo_padronizado', 'tecnologia']).emplacamentos.sum()\n",
    "b = d2_est.groupby(['ano_mes', 'marca', 'modelo_padronizado', 'tecnologia']).emplacamentos.sum()\n",
    "j = pd.concat([a, b], axis=1, keys=['nacional', 'soma_estadual']).fillna(0); j['diferenca'] = j.nacional - j.soma_estadual\n",
    "rec = j[j.diferenca != 0].reset_index(); rec.to_csv(OUT / 'auditoria' / 'd2_divergencia_nacional_vs_estadual.csv', index=False)\n",
    "registrar(log2, 'reconciliação nacional x soma das UFs por mes/modelo/tecnologia', len(rec), 'divergência mantida: ' + str(rec.to_dict('records')))\n",
    "\n",
    "mtec = agg.groupby(['marca', 'modelo_limpo']).tecnologia.apply(lambda s: ' / '.join(sorted(set(s)))).reset_index()\n",
    "mtec = mtec[mtec.tecnologia.str.contains('/')]; mtec.to_csv(OUT / 'auditoria' / 'd2_modelos_com_mais_de_uma_tecnologia.csv', index=False)\n",
    "registrar(log2, 'modelos com mais de uma tecnologia (apenas relatório)', len(mtec), 'tecnologia mantida na chave')\n",
    "pd.DataFrame([{'marca_a': 'Hitech', 'marca_b': 'Hitech E', 'obs': 'possível mesma marca; NÃO unificadas'}]).to_csv(OUT / 'auditoria' / 'd2_marcas_a_revisar.csv', index=False)\n",
    "registrar(log2, 'picos de dez/2025 (+52%) e mar/2026 (+42%) no total nacional são sazonalidade, não erro', 0)\n",
    "display(salvar_log(log2, 'd2'))\n",
    "display(rec)"
   ]
