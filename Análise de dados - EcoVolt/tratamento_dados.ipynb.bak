   "outputs": [
    {
     "name": "stdout",
     "output_type": "stream",
     "text": [
      "dSOC / (I*dt/3600) = 0.16686  ->  capacidade implícita = 5.993 Ah\n",
      "Ah integrados no arquivo = 5.587 Ah | capacidade nominal = 5,596 Ah | SOC inicial = 0.0677\n",
      "=> o SOC original foi calculado com ~5,99 Ah e começa em 6,8%; a carga integrada bate com a capacidade nominal. Origem a confirmar.\n"
     ]
    }
   ],
   "source": [
    "# SOC original: qual capacidade ele pressupõe?\n",
    "I = d3_raw['Current(A)']; soc = d3_raw.SOC\n",
    "razao = (soc.diff() / (I * dt / 3600)).replace([np.inf, -np.inf], np.nan).dropna()\n",
    "print(f'dSOC / (I*dt/3600) = {razao.median():.5f}  ->  capacidade implícita = {1 / razao.median():.3f} Ah')\n",
    "print(f'Ah integrados no arquivo = {(I.iloc[1:] * dt.iloc[1:] / 3600).sum():.3f} Ah | capacidade nominal = 5,596 Ah | SOC inicial = {soc.iloc[0]:.4f}')\n",
    "print('=> o SOC original foi calculado com ~5,99 Ah e começa em 6,8%; a carga integrada bate com a capacidade nominal. Origem a confirmar.')"
   ]
  },
