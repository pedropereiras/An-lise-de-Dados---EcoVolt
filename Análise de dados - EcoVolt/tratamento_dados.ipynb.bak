   "source": [
    "log1 = novo_log()\n",
    "d1 = d1_raw.copy()\n",
    "d1.columns = ['battery_id', 'cycle_number', 'c_rate', 'average_voltage_v', 'average_current_a', 'internal_resistance_ohm', 'soh']\n",
    "d1 = d1.sort_values(['battery_id', 'cycle_number']).reset_index(drop=True)\n",
    "registrar(log1, 'colunas padronizadas para snake_case minúsculo', len(d1))\n",
    "\n",
    "# 1) SOH > 100: capear, preservando o original\n",
    "d1['soh_original'] = d1['soh']\n",
    "m = d1.soh > 100\n",
    "d1.loc[m, 'soh'] = 100.0\n",
    "d1['soh_capeado'] = m\n",
    "registrar(log1, 'SOH > 100 capeado em 100 (original em soh_original)', m.sum(), 'ciclo 1 de todas as baterias')\n",
    "\n",
    "# 2) ciclos ausentes: listar, sem imputar\n",
    "d1['gap_antes'] = False\n",
    "for b, g in d1.groupby('battery_id'):\n",
    "    c = g.cycle_number.values\n",
    "    faltam = sorted(set(range(c.min(), c.max() + 1)) - set(c))\n",
    "    proximos = [c[c > x].min() for x in faltam]\n",
    "    d1.loc[(d1.battery_id == b) & d1.cycle_number.isin(proximos), 'gap_antes'] = True\n",
    "ausentes.to_csv(OUT / 'auditoria' / 'd1_ciclos_ausentes.csv', index=False)\n",
    "registrar(log1, 'ciclos ausentes listados (não imputados); flag gap_antes na linha seguinte ao buraco', len(ausentes))\n",
    "\n",
    "# 3) outliers por mediana móvel (janela 11)\n",
    "g = d1.groupby('battery_id')\n",
    "med_soh = g.soh.transform(rmed)\n",
    "d1['outlier_soh'] = (d1.soh - med_soh).abs() > 5\n",
    "d1['soh_suavizado'] = np.where(d1.outlier_soh, med_soh, d1.soh)\n",
    "registrar(log1, 'outlier_soh: |SOH - mediana móvel(11)| > 5 pontos; soh_suavizado substitui só os marcados', d1.outlier_soh.sum())\n",
    "\n",
    "med_v = g.average_voltage_v.transform(rmed)\n",
    "d1['outlier_tensao'] = (d1.average_voltage_v - med_v).abs() > 0.1\n",
    "d1['average_voltage_v_suavizado'] = np.where(d1.outlier_tensao, med_v, d1.average_voltage_v)\n",
    "registrar(log1, 'outlier_tensao: desvio > 0,1 V da mediana móvel(11); correção só na coluna *_suavizado', d1.outlier_tensao.sum())\n",
    "\n",
    "d1['outlier_resistencia'] = (d1.internal_resistance_ohm - g.internal_resistance_ohm.transform(rmed)).abs() > 0.02\n",
    "registrar(log1, 'outlier_resistencia: desvio > 0,02 ohm da mediana móvel(11); apenas sinalizado', d1.outlier_resistencia.sum(),\n",
    "          'CS2-34 ciclo 182 (0,127 -> 0,259 ohm, nível 0,22-0,24 depois) é mudança de nível: NÃO corrigido')\n",
    "\n",
    "# 4) resistência repetida (suspeita de forward-fill)\n",
    "d1['resistencia_repetida'] = g.internal_resistance_ohm.diff() == 0\n",
    "registrar(log1, 'resistencia_repetida: mesmo valor do ciclo anterior', d1.resistencia_repetida.sum(), 'valor não alterado')\n",
    "\n",
    "# 5) fim de vida\n",
    "d1['abaixo_80'] = d1.soh < 80\n",
    "registrar(log1, 'flag abaixo_80 (SOH < 80)', d1.abaixo_80.sum(),\n",
    "          'primeiro ciclo < 80: ' + str(d1[d1.abaixo_80].groupby('battery_id').cycle_number.min().to_dict()))\n",
    "\n",
    "cols = ['battery_id', 'cycle_number', 'c_rate', 'average_voltage_v', 'average_voltage_v_suavizado', 'average_current_a', 'internal_resistance_ohm',\n",
    "        'soh_original', 'soh', 'soh_suavizado', 'soh_capeado', 'gap_antes', 'outlier_soh', 'outlier_tensao', 'outlier_resistencia',\n",
    "        'resistencia_repetida', 'abaixo_80']\n",
    "d1 = d1[cols]\n",
    "d1_ge80 = d1[~d1.abaixo_80]\n",
    "registrar(log1, 'saída completa', len(d1))\n",
    "registrar(log1, 'saída restrita a SOH >= 80 (as linhas < 80 ficam só na versão completa)', len(d1_ge80), f'{len(d1) - len(d1_ge80)} linhas fora desta versão')\n",
    "registrar(log1, 'documentação: c_rate constante por bateria (0,5 em CS2-33/34; 1,0 em CS2-35..38), redundante com average_current_a; corrente negativa = descarga', 0,\n",
    "          'risco de vazamento ao usar c_rate junto com battery_id')\n",
    "display(salvar_log(log1, 'd1'))"
   ]
  },
