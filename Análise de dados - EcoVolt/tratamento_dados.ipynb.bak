   "source": [
    "d1_raw = pd.read_csv(RAW / 'CALCE_CS2_ML_SOH_Dataset.csv')\n",
    "print('shape:', d1_raw.shape)\n",
    "display(d1_raw.head())\n",
    "display(d1_raw.dtypes.to_frame('dtype').T)\n",
    "print('nulos por coluna:', d1_raw.isna().sum().sum())\n",
    "print('linhas duplicadas:', d1_raw.duplicated().sum(), '| chave battery_id+cycle_number duplicada:', d1_raw.duplicated(['battery_id', 'cycle_number']).sum())\n",
    "display(d1_raw.groupby('battery_id').agg(linhas=('cycle_number', 'size'), ciclo_min=('cycle_number', 'min'), ciclo_max=('cycle_number', 'max'),\n",
    "                                         c_rate=('C_rate', lambda s: sorted(s.unique()))))"
   ]
  },
